.glyphBtn.twitter { background-image: url('https://img.icons8.com/color/24/000000/twitter.png'); }
.glyphBtn.otherNetworks { background-image: url('https://img.icons8.com/material-outlined/24/000000/share.png'); }
.glyphBtn.googlePlus { background-image: url('https://img.icons8.com/color/24/000000/google-plus.png'); }
.glyphBtn.linkedIn { background-image: url('https://img.icons8.com/color/24/000000/linkedin.png'); }
