    border-radius: 8px;
    box-shadow: 0 4px 16px rgba(0,0,0,0.15);
    z-index: 100;
    padding: 8px 0;
    animation: fadeIn 0.2s;
}

@keyframes fadeIn {
    from { opacity: 0; transform: translateY(-10px);}
    to { opacity: 1; transform: translateY(0);}
}

.menu-share ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
}

.menu-share .dropdown-header {
    font-size: 13px;
    color: #888;
    padding: 8px 16px 4px 16px;
    font-weight: bold;
    flex-basis: 100%;
}

.menu-share li {
    margin: 0; 
    width: 100%;
}

.menu-share a {
    display: flex;
    align-items: center;
    padding: 8px 16px;
    color: #333;
    text-decoration: none;
    font-size: 15px;
    width: 100%; /* Ocupa toda a largura do menu */
    transition: background 0.2s, color 0.2s;
    background: none;
    box-sizing: border-box;
}

.menu-share a:hover {
    background: #f5f5f5;
    color: #007bff;
}

.menu-share .glyphBtn {
    margin-right: 10px;
}

.dropdown-share {
    position: relative;
}

.dropdown-toggle {
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    margin: 0;
}

.dropdown-toggle:focus {
    outline: none;
}

/* Tooltip simples */
.showTooltip[title]:hover::after {
    content: attr(title);
    position: absolute;
    top: -32px;
    left: 50%;
    transform: translateX(-50%);
    background: #222;
    color: #fff;
    padding: 5px 10px;
    border-radius: 4px;
    font-size: 13px;
    white-space: nowrap;
    z-index: 200;
    opacity: 1;
    pointer-events: none;
}

/* Responsivo */
@media (max-width: 600px) {
    .menu-share {
        min-width: 180px;
        left: 0;
        right: auto;
    }
    .menu-share ul {
        flex-direction: column;
        align-items: flex-start;
    }
    .menu-share li {
        margin: 0 0 4px 0;
    }
}
