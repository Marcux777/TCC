                'idle_fuel_rate_us_gal_per_hour': 0.8,
                'carbon_factor_kg_per_us_gal': 10.18,
                'engine_on_fraction': 1.0,
                'sensitivity_us_gal_per_hour': [
                    0.5,
                    1.0,
