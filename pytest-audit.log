n': {'definition': 'Summed busy resource-minutes divided by summed gross resource-minutes.', 'unit': 'fraction', 'population': 'All initial physical resources, weighted by their resource-minutes.', 'window': 'Observed canonical day [0,720] minutes; services may finish at 720 but cannot start at 720.'}, 'net_utilization': {'definition': 'Summed busy resource-minutes divided by summed available resource-minutes; zero available time is undefined.', 'unit': 'fraction', 'population': 'All initial physical resources, weighted by their resource-minutes.', 'window': 'Observed canonical day [0,720] minutes; services may finish at 720 but cannot start at 720.'}, 'net_idle_fraction': {'definition': 'Summed available idle time divided by summed available time; zero available time is undefined.', 'unit': 'fraction', 'population': 'All initial physical resources, weighted by their resource-minutes.', 'window': 'Observed canonical day [0,720] minutes; services may finish at 720 but cannot start at 720.'}, 'gross_idle_fraction': {'definition': 'Summed available idle time divided by summed gross time; downtime is excluded from the numerator.', 'unit': 'fraction', 'population': 'All initial physical resources, weighted by their resource-minutes.', 'window': 'Observed canonical day [0,720] minutes; services may finish at 720 but cannot start at 720.'}, 'decision_count': {'definition': 'Number of persisted recommendations.', 'unit': 'decisions', 'population': 'Persisted DECISION_RECORDED recommendations, including subsequent rejection.', 'window': 'Observed canonical day [0,720] minutes; services may finish at 720 but cannot start at 720.'}, 'fifo_break_count': {'definition': 'Recommendations selecting other than the earliest (stage_entry_time,truck_id) within the recorded admitted queue.', 'unit': 'decisions', 'population': 'Persisted DECISION_RECORDED recommendations, including subsequent rejection.', 'window': 'Observed canonical day [0,720] minutes; services may finish at 720 but c