E                          'co2_assumptions': {'carbon_factor_kg_per_us_gal': 10.18,
E                                              'carbon_factor_source': 'US EPA, SmartWay '
E                                                                      '2024 Table 1: '
E                                                                      'diesel 10,180 g '
E                                                                      'CO2/US gal, '
E                                                                      'converted to '
E                                                                      '10.18 kg; 100% '
E                                                                      'combustion.',
E                                              'carbon_factor_source_url': 'https://nepis.epa.gov/Exe/ZyPURL.cgi?Dockey=P101961J.txt',
E                                              'engine_on_fraction': 1.0,
E                                              'engine_on_source': 'Explicit project '
E                                                                  'assumption, not an '
E                                                                  'empirical '
E                                                                  'observation: engine '
E                                                                  'on throughout '
E                                                                  'eligible waiting.',
E                                              'fuel_rate_source': 'US DOE, Long-Haul '
E                                                                  'Truck Idling Burns '
E                                                                  'Up Profits (2015): '
E                                                                  'approximately 0.8 US '
E                                                                  'gal/hour.',
E                                              'fuel_rate_source_url': 'https://afdc.energy.gov/uploads/publication/hdv_idling_2015.pdf',
E                                              'idle_fuel_rate_us_gal_per_hour': 0.8,
E                                              'scope': 'Combustion-only exploratory '
E                                                       'estimate over observed eligible '
E                                                       'queue time, including censored '
E                                                       'waits; not H1/IUT.',
E                                              'sensitivity_source': 'Assumed fuel-rate '
E                                                                    'scenarios, not '
E                                                                    'measured '
E                                                                    'confidence bounds.',
E                                              'sensitivity_us_gal_per_hour': [0.5, 1.0]},
E                          'conventions': {'admission_diagnostics': 'RUN_STARTED must '
E                                                                   'register '
E                                                                   'admission_mode as '
E                                                                   'full_queue or '
E                                                                   'mandatory_window. '
E                                                                   'H0 activation '
E                                                                   'counts '
E                                                                   'mandatory_window '
E                                                                   'decisions without a '
E                                                                   'mandatory truck and '
E                                                                   'with more '
E                                                                   'hard-feasible '
E                                                                   'candidates than H0; '
E                                                                   'mandatory and '
E                                                                   'critical-expansion '
E                                                                   'candidate counts '
E                                                                   'are decision '
E                                                                   'exposures, not '
E                                                                   'distinct trucks. '
E                                                                   'Critical expansion '
E                                                                   'counts pressured '
E                                                                   'candidates beyond '
E                                                                   'the ordinary '
E                                                                   'prefix. full_queue '
E                                                                   'does not apply a '
E                                                                   'window or '
E                                                                   'mandatory-priority '
E                                                                   'filter.',
E                                          'co2': 'Exploratory eligible queue minutes/60 '
E                                                 '* idle fuel rate in US gal/hour * '
E                                                 '10.18 kg CO2/US gal * '
E                                                 'engine_on_fraction. Base fuel rate=.8 '
E                                                 'and assumed engine_on_fraction=1.0. '
E                                                 'Sensitivity rates .5 and 1.0 are '
E                                                 'assumed scenarios, not measured '
E                                                 'bounds. Includes censored observed '
E                                                 'queue waiting; excludes document '
E                                                 'holds, travel, cold start, dust, '
E                                                 'electricity and fuel lifecycle; never '
E                                                 'enters H1/IUT.',
E                                          'documents': 'Document holds are '
E                                                       'arrival-to-release or '
E                                                       'arrival-to-horizon intervals, '
E                                                       'reported separately from '
E                                                       'eligible queue waiting; they do '
E                                                       'not change the primary H1 '
E                                                       'waiting estimand.',
E                                          'fifo': 'A FIFO break selects a different '
E                                                  'truck from the earliest '
E                                                  '(stage_entry_time,truck_id) in the '
E                                                  'recorded admissible candidate queue; '
E                                                  'the recorded justification must '
E                                                  'agree.',
E                                          'maxima': 'Queue and occupancy peaks are '
E                                                    'counts observed after each public '
E                                                    'state transition, not time '
E                                                    'integrals. Buffer occupancy is the '
E                                                    'maximum of the three intermediate '
E                                                    'queues and inbound reservation; '
E                                                    'buffer reservation is the maximum '
E                                                    'of inbound (scale_in plus unload, '
E                                                    'active or queued) and outbound '
E                                                    '(active unload plus queued '
E                                                    'scale_out) reservations.',
E                                          'operator': 'Accept/reject counts describe '
E                                                      'persisted operator decisions. '
E                                                      'Synthetic auto-accept events are '
E                                                      'not evidence of human validation '
E                                                      'or intervention.',
E                                          'quantiles': 'p50 and medians use the '
E                                                       'arithmetic median; p95 waiting '
E                                                       'uses nearest rank ceil(.95*N); '
E                                                       'IQR uses linearly interpolated '
E                                                       'quartiles (R7).',
E                                          'raw_fifo': 'Raw FIFO orders all arrived, '
E                                                      'non-active, unfinished trucks '
E                                                      'whose next operation uses the '
E                                                      'physical resource kind, before '
E                                                      'document, cargo, buffer and '
E                                                      'mandatory-priority filters. A '
E                                                      'raw break is avoidable only when '
E                                                      'this first truck is '
E                                                      'hard-eligible and satisfies the '
E                                                      "registered admission mode's "
E                                                      'mandatory-priority restriction. '
E                                                      'No metric branches on a policy '
E                                                      'name.',
E                                          'replanning': 'Count of consecutive observed '
E                                                        'queue comparisons with a '
E                                                        'changed relative order, '
E                                                        'divided by horizon hours for '
E                                                        'frequency. It is not a count '
E                                                        'of hypothetical solver runs or '
E                                                        'human replans.',
E                                          'resource_time': 'Busy intervals include '
E                                                           'service still active at the '
E                                                           'horizon. Downtime is the '
E                                                           'union of effective '
E                                                           'disruption intervals, '
E                                                           'reconciled with physical '
